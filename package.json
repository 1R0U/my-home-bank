{
  "name": "my-home-bank",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build:scene": "node scripts/build-rpg-scene.mjs",
    "postinstall": "node scripts/sync-babylon.mjs && npm run build:scene",
    "start": "npm run build:scene && expo start --go",
    "start:parent": "npm run build:scene && cross-env EXPO_PUBLIC_DEV_ROLE=parent expo start --go",
    "start:child": "npm run build:scene && cross-env EXPO_PUBLIC_DEV_ROLE=child expo start --go",
    "migration:new": "node scripts/create-migration.mjs",
    "migration:check": "node scripts/check-migrations.mjs",
    "db:types": "node scripts/generate-db-types.mjs",
    "test": "npm run test:unit && npm run test:render",
    "test:unit": "node --experimental-strip-types --test 'tests/*.test.mjs'",
    "test:render": "jest --runInBand"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "^2.0.0",
    "@react-three/fiber": "^9.7.0",
    "@supabase/supabase-js": "^2.49.0",
    "expo": "~58.0.19",
    "expo-asset": "~58.0.18",
    "expo-audio": "~58.0.10",
    "expo-constants": "~58.0.13",
    "expo-dev-client": "~58.0.15",
    "expo-file-system": "~58.0.11",
    "expo-font": "~58.0.10",
    "expo-gl": "~58.0.3",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.14",
    "expo-notifications": "~58.1.6",
    "expo-router": "~58.0.26",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "expo-updates": "~58.0.18",
    "expo-web-browser": "~58.0.6",
    "nativewind": "^4.1.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "~0.21.4",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0",
    "three": "^0.180.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@react-native/jest-preset": "^0.88.0",
    "@testing-library/react-native": "^13.3.3",
    "@types/node": "^20.11.0",
    "@types/react": "~19.2.4",
    "babylonjs": "^9.25.0",
    "cross-env": "^10.1.0",
    "esbuild": "^0.28.2",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.12",
    "react-test-renderer": "^19.3.0",
    "tailwindcss": "^3.4.17",
    "typescript": "~6.0.3"
  }
}
