    "android": "expo start --android",
    "android:parent": "cross-env EXPO_PUBLIC_DEV_ROLE=parent expo start --android",
    "android:child": "cross-env EXPO_PUBLIC_DEV_ROLE=child expo start --android",
    "ios": "expo start --ios",
