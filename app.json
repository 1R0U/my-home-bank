{
  "expo": {
    "name": "my-home-bank",
    "slug": "my-home-bank",
    "version": "1.0.0",
    "scheme": "my-home-bank",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "商品画像を選択するために写真ライブラリへのアクセスを許可してください"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "商品画像を選択するために写真ライブラリへのアクセスを許可してください",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
